# Copy this file to config.env and edit the machine-specific values.

# External data resources. None of these files is bundled.
DATA_PATH="$PROJECT_ROOT/../BrowseCore/ourdata/data/test-*.parquet"
CORPUS_PARQUET_PATH="$PROJECT_ROOT/../BrowseCore/corpus/data/*.parquet"
DENSE_INDEX_PATH="$PROJECT_ROOT/../BrowseCore/training-indexes/qwen3-embedding-8b/*.pkl"
DENSE_MODEL_NAME="Qwen/Qwen3-Embedding-8B"

# Optional runtime overrides.
PYTHON_BIN="python"
PROMPT_FILE="$PROJECT_ROOT/prompts/liter_research_prompt.py"

# Hugging Face IDs can be replaced by local model directories on offline hosts.
# MODEL="simplex-ai-inc/LiteResearcher-4B"
# DENSE_MODEL_NAME="/absolute/path/to/Qwen3-Embedding-8B"
# HF_HOME="/absolute/path/to/huggingface-cache"

# GPU and port overrides.
# VLLM_GPUS="0,1"  # One TP=2 vLLM server; not two independent replicas.
# SEARCH_GPU="2"
# VLLM_PORT_1="8008"
# SEARCH_PORT="8005"
# ASAG_PORT="8010"
# ASAG_GPU="3"  # Used only by the pure-ASAG launcher.
#
# Hybrid single-worker topology:
VLLM_GPU_1="6"
SEARCH_GPU="5"
# PLUGIN_PORT_1="8032"
# VLLM_PORT_1="8033"
# SEARCH_PORT_1="8034"
# VLLM_PORT_2="8035"
# PLUGIN_PORT_2="8036"
# SEARCH_PORT_2="8037"
# Hybrid ASAG uses the /analyze endpoint on PLUGIN_PORT_1; there is no
# separate ASAG GPU or port.

# Runtime tuning.
# VLLM_GPU_MEMORY_UTILIZATION="0.65"
# VLLM_MAX_MODEL_LEN="32768"
# MAX_ROUNDS="80"
# MAX_CONCURRENCY_PER_WORKER="3"
# FRESH_RUN="1"  # Process all QIDs; refuse to mix with existing result shards.
# OPENRESEARCHER_MAX_INPUT_TOKENS="23000"  # LiteResearcher_original default.
# OPENRESEARCHER_TOOL_RESPONSE_TOKENS="2048"
# OPENRESEARCHER_CONTEXT_REBUILD_TOKENS="16000"
# QID_FILE="$PROJECT_ROOT/qids_fixed_reroute_20.txt"
OUTPUT_DIR="$PROJECT_ROOT/results/ourdata/LiteResearcher4B_ASAG_06B_hint_E2E_GRPO_step70_alpha20_host_rewrite_reroute20"
RUN_NAME="LiteResearcher4B_ASAG_06B_hint_E2E_GRPO_step70_alpha20_host_rewrite_reroute20"

# Retrieval-boundary ASAG. Paper defaults: lambda=0.95, alpha=-0.1, s=1.
# ASAG_ENABLED="1"
# ASAG_CONFIDENCE_THRESHOLD="0.95"
# ASAG_ENTROPY_DELTA_THRESHOLD="-0.10"
# ASAG_MAX_REROUTES="1"
# ASAG_ATTENTION_MARGIN="0.0"
# ASAG_ATTENTION_DTYPE="bfloat16"
# ASAG_ANSWER_PROBE_MAX_TOKENS="32"
# ASAG_FAIL_OPEN="0"  # 0 prevents silently falling back to vanilla research.

# Stateful attention KV and the paper's total decoding/query window.
# ASAG_DECODING_WINDOW_TOKENS="32"
# ASAG_MAX_PROBE_TOKENS="64"
# ASAG_MAX_HISTORY_TOKENS="24000"
# ASAG_MAX_CACHED_SESSIONS="3"  # Per sidecar/worker in the hybrid launcher.
# ASAG_KV_OFFLOAD="0"
# ASAG_SELECTIVE_ATTENTION="1"
# ASAG_MONITORED_LAYERS="4"

# ASAG/0.6B-triggered GRPO corrected-logits query generation.
PLUGIN_GRPO_SOURCE_ROOT="$PROJECT_ROOT/../0_GRPO_plug_end_to_end"
PLUGIN_CHECKPOINT="$PLUGIN_GRPO_SOURCE_ROOT/verl_checkpoints_deepresearch_hint_e2e_grpo_not_good/global_step_70/plugin"
PLUGIN_ALPHA="20.0"
PLUGIN_REROUTE_SEED="20260907"
PLUGIN_REROUTE_FORMAT_ATTEMPTS="3"
# PLUGIN_CONTROLLER_TEMPERATURE="1.0"
# PLUGIN_REROUTE_TEMPERATURE="1.0"
# PLUGIN_REROUTE_TOP_P="0.95"
PLUGIN_HINT_SLOT_BUDGETS="16,12,12"
PLUGIN_HINT_TEMPERATURE="1.0"
PLUGIN_HINT_TOP_P="0.95"
PLUGIN_HINT_CORRECTION_TOPK="128"
PLUGIN_HINT_QUERY_MAX_WORDS="24"
GRPO_HOST_QUERY_TEMPERATURE="0.7"
GRPO_HOST_QUERY_MAX_NEW_TOKENS="32"
GRPO_HOST_QUERY_MAX_WORDS="16"
PLUGIN_MAX_LENGTH="4096"

# Guarded-OR joint trigger. ASAG retains Stop/Verify priority, while the trained
# 0.6B controller may promote a low-confidence ASAG Continue to Reroute.
JOINT_CONTROLLER_ENABLED="1"
JOINT_CONTROLLER_REROUTE_THRESHOLD="0.30"
JOINT_CONTROLLER_MAX_REROUTES="1"
JOINT_CONTROLLER_MIN_REROUTE_ROUNDS="8"
JOINT_CONTROLLER_REROUTE_COOLDOWN_ROUNDS="4"

# Retry corrected-logits retrieval errors and reserve enough rounds to consume
# late reroute evidence. The dynamic extension is capped at MAX_ROUNDS + 20.
GRPO_REROUTE_SEARCH_ATTEMPTS="2"
GRPO_MIN_POST_REROUTE_ROUNDS="20"
GRPO_MAX_EXTRA_REROUTE_ROUNDS="20"
